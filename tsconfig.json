{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest", "node"],
    // The domain the Edge Functions import names its files with their `.ts`
    // extension, which the Edge Runtime needs.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // The Edge Functions run in Deno, with its own types and imports: `deno check`
  // checks them (see the Types job of the CI).
  "exclude": ["node_modules", "supabase/functions"]
}

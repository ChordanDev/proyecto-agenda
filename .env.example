# Copy this file to .env.local (ignored by git) and fill in the values.
# For the local Supabase, `npx supabase status` shows them as API_URL and ANON_KEY (`npx supabase status -o env`).
# These two values are public by design: they are bundled into the app.
# Never put a service role key or any other secret in an EXPO_PUBLIC_ variable.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The key of OpenAI is not here: the app never has it. It is a secret of the
# server: `supabase secrets set OPENAI_API_KEY=...` for a project, and
# supabase/functions/.env (ignored by git) for `supabase functions serve`.

# Key of Google Maps for the map of "Nueva iglesia" and "Editar iglesia" on
# Android (Maps SDK for Android, restricted to the package of the app). It is
# read by app.config.ts when the development build is made, not by the bundle.
# For EAS builds it is an environment variable of the EAS project.
GOOGLE_MAPS_ANDROID_API_KEY=
